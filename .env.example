# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to git. (.gitignore already excludes it.)

# ---- tastytrade ----
# Use "sandbox" while testing. Flip to "live" only when you're ready
# to trade real money. The base URL is selected automatically.
TASTYTRADE_ENV=sandbox

# Your tastytrade login (sandbox or live, must match TASTYTRADE_ENV above)
TASTYTRADE_USERNAME=your_username_or_email
TASTYTRADE_PASSWORD=your_password

# ---- Anthropic / Claude ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ---- Risk & sizing ----
# Notional account size used for sizing in sandbox. Ignored when live
# (live mode reads your real account balance from tastytrade).
NOTIONAL_ACCOUNT_SIZE=10000

# Percent of account to risk per trade (1.0 = 1%)
RISK_PER_TRADE_PCT=1.0

# Max trades per day, max concurrent open positions
MAX_TRADES_PER_DAY=3
MAX_OPEN_POSITIONS=5

# If portfolio drops more than this % in a single day, all trading halts
DAILY_LOSS_HALT_PCT=5.0

# Minimum screener score (0-100) for a candidate to be considered
MIN_SCORE=60

# ---- Behaviour flags ----
# DRY_RUN=true means: run the full pipeline but DO NOT send orders.
# Useful for debugging. Set to false to actually place orders.
DRY_RUN=true
